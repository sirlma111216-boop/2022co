rules_version = '2';

// ============================================================================
//  거꾸로 설계 연수실 — Firestore 보안 규칙
//
//  원칙
//   1. 참가자는 자기 문서만 쓴다 (design, reflections/{uid}).
//   2. 같은 세션의 참가자만 읽는다 → 연수 코드가 다르면 아무것도 볼 수 없다.
//   3. 글은 작성자만 수정·삭제. 공감(likes)만 다른 참가자가 바꿀 수 있다.
//   4. 강사 권한은 클라이언트 boolean이 아니라 instructors/{uid} 문서 존재로만 판정한다.
//   5. 세션 문서는 강사만 수정. 단 투표 집계 필드는 참가자가 increment 할 수 있다.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 이 세션에 실제로 입장한 사람인가 (participants 문서 존재로 판정)
    function isMember(sid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sessions/$(sid)/participants/$(request.auth.uid));
    }

    // 강사 화이트리스트 — 콘솔에서 수동으로 문서를 만든 계정만 강사다.
    function isInstructor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/instructors/$(request.auth.uid));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── 강사 화이트리스트 ──────────────────────────────────────────────────
    // 읽기는 본인 확인용으로만 허용. 쓰기는 Firebase 콘솔/관리자 SDK로만 한다.
    match /instructors/{uid} {
      allow get: if isSelf(uid);
      allow list, write: if false;
    }

    // ── 세션 ───────────────────────────────────────────────────────────────
    match /sessions/{sid} {
      // 코드를 아는 사람만 문서 ID로 직접 접근한다. 목록 조회(list)는 강사만.
      allow get: if isSignedIn();
      allow list: if isInstructor();

      // 강사가 없는 상태에서도 연수가 굴러가야 하므로 참가자의 최초 생성을 허용한다.
      allow create: if isSignedIn()
        && request.resource.data.joinCode == sid
        && request.resource.data.currentStep is string;

      // 강사는 전부 수정 가능. 참가자는 투표 집계 필드만 건드릴 수 있다.
      allow update: if isInstructor()
        || (isSignedIn() && changedKeys().hasOnly(['pollResults', 'taskPollResults']));

      allow delete: if isInstructor() && resource.data.ownerUid == request.auth.uid;

      // ── 참가자 ───────────────────────────────────────────────────────────
      match /participants/{uid} {
        allow read: if isMember(sid) || isInstructor() || isSelf(uid);
        allow create, update: if isSelf(uid);
        allow delete: if isSelf(uid) || isInstructor();

        // 개인 설계안 — 본인만 읽고 쓴다. 강사도 읽기만 가능.
        match /design/{docId} {
          allow read: if isSelf(uid) || isInstructor();
          allow write: if isSelf(uid);
        }
      }

      // ── 공유 담벼락 ──────────────────────────────────────────────────────
      match /posts/{postId} {
        allow read: if isMember(sid) || isInstructor();

        allow create: if isMember(sid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.likes == 0
          && request.resource.data.likedBy.size() == 0
          && request.resource.data.isPinned == false;

        // 작성자: 자기 글 수정 / 다른 참가자: 공감·댓글만 / 강사: 고정 등 전부
        allow update: if isInstructor()
          || (isSelf(resource.data.uid) && !changedKeys().hasAny(['uid', 'isPinned']))
          || (isMember(sid) && changedKeys().hasOnly(['likes', 'likedBy']))
          || (isMember(sid) && changedKeys().hasOnly(['comments']));

        allow delete: if isSelf(resource.data.uid) || isInstructor();
      }

      // ── 성찰 ─────────────────────────────────────────────────────────────
      // 한 문장 성찰은 함께 보여 주므로 같은 세션 참가자에게 읽기를 연다.
      match /reflections/{uid} {
        allow read: if isMember(sid) || isInstructor();
        allow create, update: if isSelf(uid);
        allow delete: if isSelf(uid) || isInstructor();
      }

      // ── AI 사용량 ────────────────────────────────────────────────────────
      match /aiUsage/{uid} {
        allow read: if isSelf(uid) || isInstructor();
        allow write: if isSelf(uid);
      }
    }

    // 그 밖의 모든 경로는 금지
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
