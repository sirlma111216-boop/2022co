{
  "name": "backward-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "2022 개정 교육과정 기반 수업·평가 설계 교사 연수 웹앱 (3차시 150분 워크숍)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
