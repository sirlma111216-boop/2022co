# ==========================================================================
#  거꾸로 설계 연수실 — 환경변수 예시
#  이 파일을 복사해서 `.env.local` 을 만든 뒤 값을 채우세요.  (cp .env.example .env.local)
#  .env.local 은 git에 올라가지 않습니다.
# ==========================================================================

# --------------------------------------------------------------------------
# 1) Firebase (클라이언트) — 없으면 앱은 자동으로 '로컬 저장소 모드'로 동작합니다.
#    로컬 모드에서도 개인 작성 / 자동 저장 / A4 출력은 모두 정상 동작합니다.
#    (담벼락·실시간 투표·강사 대시보드만 비활성화됩니다.)
#    값은 Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성 에서 복사합니다.
#    ※ 이 값들은 공개되어도 안전한 값입니다(보안은 Firestore 규칙이 담당).
# --------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --------------------------------------------------------------------------
# 2) 생성형 AI — ★ 서버 전용. 절대 VITE_ 접두사를 붙이지 마세요(번들에 노출됩니다).
#    Cloudflare Pages: 대시보드 > Settings > Variables and Secrets 에 'Secret' 타입으로 등록
#    Firebase Functions: firebase functions:secrets:set GCP_SERVICE_ACCOUNT
# --------------------------------------------------------------------------

# (권장 / 배포용) Vertex AI 서비스 계정 JSON 전체를 한 줄로 붙여넣습니다.
# Cloudflare 같은 엣지에서는 AI Studio API가 지역 차단으로 간헐 실패하므로 Vertex를 씁니다.
GCP_SERVICE_ACCOUNT=

# (로컬 개발 전용) 위 값이 없을 때만 AI Studio API로 폴백합니다.
# https://aistudio.google.com/apikey 에서 발급.
GEMINI_API_KEY=

# 사용할 모델. 비우면 gemini-2.5-flash-lite (빠르고 저렴한 Flash 계열).
GEN_AI_MODEL=gemini-2.5-flash-lite

# 서버 측 rate limit — 한 IP가 1분에 호출할 수 있는 횟수 (기본 6)
AI_RATE_PER_MIN=6
